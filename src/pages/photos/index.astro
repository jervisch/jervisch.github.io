---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getPhotoGradient } from '../../lib/photoGradient';

const photos = (await getCollection('photos'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const collections = new Map<string, typeof photos>();
for (const photo of photos) {
  const key = photo.data.collection;
  if (!collections.has(key)) collections.set(key, []);
  collections.get(key)!.push(photo);
}

const collectionEntries = Array.from(collections.entries()).map(([name, collectionPhotos]) => {
  const firstPhoto = collectionPhotos[0];
  return {
    name,
    count: collectionPhotos.length,
    heroImage: firstPhoto.data.image,
    heroTitle: firstPhoto.data.title,
    locations: [...new Set(collectionPhotos.map(p => p.data.location).filter(Boolean))],
    dateRange: (() => {
      const dates = collectionPhotos.map(p => p.data.date);
      const newest = new Date(Math.max(...dates.map(d => d.valueOf())));
      const oldest = new Date(Math.min(...dates.map(d => d.valueOf())));
      const fmt = (d: Date) => new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(d);
      return newest.getFullYear() === oldest.getFullYear() && newest.getMonth() === oldest.getMonth()
        ? fmt(newest)
        : `${fmt(oldest)} — ${fmt(newest)}`;
    })(),
  };
});
---

<BaseLayout title="Photos" description="Moments from around Singapore and beyond.">
  <header class="archive-head">
    <h1 class="type-display">Photos</h1>
    <p class="archive-intro">
      Moments from around Singapore and beyond, grouped by where they happened.
    </p>
  </header>

  <section class="collection-grid">
    {collectionEntries.map(collection => (
      <article class="collection-card" id={collection.name.toLowerCase().replace(/\s+/g, '-')}>
        <a href={`/photos/${collection.name.toLowerCase().replace(/\s+/g, '-')}/`} class="collection-link">
          <div class="collection-hero" style={`background: ${getPhotoGradient(collection.heroImage)};`}>
            {collection.heroImage && <img src={collection.heroImage} alt={collection.heroTitle} loading="lazy" />}
          </div>
          <div class="collection-info">
            <h2 class="collection-name">{collection.name}</h2>
            <p class="collection-meta">
              <span class="collection-date">{collection.dateRange}</span>
              <span class="collection-count">{collection.count} {collection.count === 1 ? 'photo' : 'photos'}</span>
            </p>
            {collection.locations.length > 0 && (
              <p class="collection-locations">{collection.locations.join(' · ')}</p>
            )}
          </div>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .archive-head {
    padding-block: var(--section-pad) var(--heading-gap);
    max-width: 42ch;
  }

  .archive-intro {
    margin-top: 28px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--grid-gap);
  }

  .collection-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
  }

  .collection-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
  }

  .collection-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .collection-hero {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }

  .collection-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .collection-card:hover .collection-hero img {
    transform: scale(1.05);
  }

  .collection-info {
    padding: 24px;
  }

  .collection-name {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 8px;
    transition: color 0.2s;
  }

  .collection-card:hover .collection-name {
    color: var(--accent);
  }

  .collection-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .collection-locations {
    font-size: 0.8125rem;
    font-weight: 300;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 700px) {
    .collection-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Projects" description="What I'm making, and what's still growing.">
  <header class="archive-head">
    <h1 class="type-display">Projects</h1>
    <p class="archive-intro">
      What I'm making, and what's still growing.
      Some finished, some paused, some still a sketch.
    </p>
  </header>

  <h2 class="type-label index-label">Index</h2>

  <ol class="archive" id="projects-list">
    {projects.map((project, i) => (
      <li class="archive-row">
        <a href={`/projects/${project.id}/`} class="archive-link">
          <span class="archive-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="archive-main">
            <span class="archive-title">{project.data.title}</span>
            <span class="archive-desc">{project.data.description}</span>
          </span>
          <span class="archive-meta">
            {project.data.year && <span class="archive-year">{project.data.year}</span>}
          </span>
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>

<style>
  .archive-head {
    padding-block: var(--section-pad) var(--heading-gap);
    max-width: 40ch;
  }

  .archive-intro {
    margin-top: 28px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .index-label {
    margin: 0 0 20px;
  }

  /* ─── Archive index ─── */
  .archive {
    display: flex;
    flex-direction: column;
  }

  .archive-row {
    border-top: 1px solid var(--border);
    transition: border-color 0.4s, opacity 0.2s;
  }

  .archive-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .archive-link {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) 10rem;
    gap: var(--grid-gap);
    align-items: baseline;
    padding: 30px 0;
    transition: color 0.2s;
  }

  .archive-num {
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    color: var(--text-muted);
  }

  .archive-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .archive-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
    transition: color 0.2s;
  }

  .archive-link:hover .archive-title {
    color: var(--accent);
  }

  .archive-desc {
    font-size: 0.9375rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 52ch;
  }

  .archive-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-end;
    text-align: right;
  }

  .archive-year {
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 700px) {
    .archive-link {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 12px;
    }

    .archive-meta {
      grid-column: 2;
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
      text-align: left;
    }
  }
</style>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Timeline from '../../components/Timeline.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const { status, year, url } = project.data;
---

<BaseLayout title={project.data.title} description={project.data.description} prose>
  <a href="/projects/" class="back-link">← Back to Projects</a>

  <article class="project">
    <header class="project-header">
      <h1 class="type-title project-title">{project.data.title}</h1>
      <p class="project-deck">{project.data.description}</p>

      {(status || year || project.data.tags.length > 0) && (
        <div class="project-meta">
          {status && <span class="type-meta">{status}</span>}
          {year && <span class="type-meta">{year}</span>}
          {project.data.tags.map(tag => <span class="type-meta">{tag}</span>)}
        </div>
      )}
    </header>

    <div class="prose project-body">
      <Content />
    </div>

    <Timeline refs={project.data.relatedWork} />

    {url && url !== '#' && (
      <div class="project-outbound">
        <a href={url} class="arrow-link" target="_blank" rel="noopener noreferrer">
          View project
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    )}

    <footer class="project-footer">
      <a href="/projects/" class="back-link">← All Projects</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .project-header {
    padding-bottom: var(--heading-gap);
    margin-bottom: clamp(40px, 5vw, 56px);
    border-bottom: 1px solid var(--border);
    transition: border-color 0.4s;
  }

  .project-title {
    margin: 0;
    max-width: 22ch;
  }

  .project-deck {
    margin-top: 20px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 48ch;
  }

  .project-meta {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .project-outbound {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .project-footer {
    margin-top: 56px;
  }

  .project-footer .back-link {
    margin-bottom: 0;
  }
</style>
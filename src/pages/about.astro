---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout title="About" description="About Jervis Chan — engineer in Singapore.">
  <header class="about-head">
    <h1 class="type-display">About</h1>
    <p class="about-statement">
      I like understanding how things work.<br />
      Then I like making them work better.
    </p>
    {SITE.now && <p class="about-now">Now: {SITE.now}</p>}
  </header>

  <div class="editorial-grid about-grid">
    <div class="about-visual">
      <!--
        No portrait of Jervis exists in the repository yet. This slot is
        honest about that rather than passing a gradient off as a photo.
        Drop a file at public/images/about.jpg and it will render instead.
      -->
      <div class="about-portrait">
        <span class="about-portrait-label">Portrait to come</span>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-head {
    padding-block: var(--section-pad) var(--heading-gap);
    max-width: 40ch;
  }

  .about-statement {
    margin-top: 28px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    line-height: 1.35;
    color: var(--text);
  }

  .about-now {
    margin-top: 28px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 44ch;
  }

  .about-visual {
    grid-column: 1 / span 4;
  }

  .about-portrait {
    position: sticky;
    top: 40px;
    aspect-ratio: 4 / 5;
    background: var(--bg-subtle);
    border: 1px dashed var(--border-strong);
    display: flex;
    align-items: flex-end;
    padding: 20px;
  }

  .about-portrait-label {
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.7;
  }

  @media (max-width: 1024px) {
    .about-visual { grid-column: 1 / span 8; }

    .about-portrait {
      position: static;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 700px) {
    .about-visual {
      grid-column: 1 / -1;
    }

    .about-statement br {
      display: none;
    }
  }
</style>
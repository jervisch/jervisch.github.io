---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import NoteList from '../components/NoteList.astro';
import PhotoMosaic from '../components/PhotoMosaic.astro';
import HeroAnimation from '../components/HeroAnimation.astro';
import { SITE } from '../config';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes'))
  .filter(n => !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
---

<BaseLayout currentPath="/" home>
  <!-- ─── Hero ─── -->
  <section class="hero">
    <HeroAnimation />
    <h1 class="hero-name type-display">
      I make things,<br />
      think about systems,<br />
      and notice too much.
    </h1>
    <p class="hero-meta type-meta">
      {SITE.name} · {SITE.location} · Engineer
    </p>
  </section>

  <!-- ─── Projects ─── -->
  <section class="projects-section">
    <header class="section-header">
      <h2 class="type-title">Projects</h2>
      <a href="/projects/" class="section-view-all">All Projects →</a>
    </header>

    <div class="projects-cards">
      {projects.slice(0, 3).map((project, i) => (
        <ProjectEntry
          number={i + 1}
          title={project.data.title}
          description={project.data.description}
          href={`/projects/${project.id}/`}
          cover={project.data.cover}
          tags={project.data.tags}
          flip={i % 2 === 1}
        />
      ))}
    </div>
  </section>

  <!-- ─── Notes ─── -->
  <section class="section notes-section">
    <header class="section-header">
      <h2 class="type-title">Notes</h2>
      <a href="/notes/" class="section-view-all">All Notes →</a>
    </header>
    {notes.length > 0 && (
      <NoteList
        notes={notes.slice(0, 5).map(note => ({
          title: note.data.title,
          href: `/notes/${note.id}/`,
          date: note.data.date,
        }))}
      />
    )}
  </section>

  <!-- ─── Photos ─── -->
  <section class="section photos-section">
    <header class="section-header">
      <h2 class="type-title">Photos</h2>
      <a href="/photos/" class="section-view-all">All Photos →</a>
    </header>
    <PhotoMosaic />
  </section>
</BaseLayout>

<style>
  /* ─── Hero ─── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(48px, 7vw, 88px);
    position: relative;
    z-index: 1;
  }

  .hero-name {
    margin: 0;
    position: relative;
    z-index: 2;
  }

  .hero-meta {
    margin-top: 40px;
    position: relative;
    z-index: 2;
  }

  .hero-animation {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* ─── Projects Section ─── */
  .projects-section {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--section-pad) var(--page-pad) calc(var(--section-pad) + 60px);
  }

  .projects-cards {
    display: flex;
    flex-direction: column;
    gap: 0;
    flex: 1;
  }

  .projects-cards .feature {
    min-height: calc((100svh - 200px) / 3);
  }

  @media (max-width: 700px) {
    .projects-section {
      min-height: auto;
      padding: var(--section-pad) var(--page-pad) calc(var(--section-pad) + 40px);
    }

    .projects-cards .feature {
      min-height: auto;
    }
  }

  /* ─── Section Headers ───
     .section-header and .section-view-all are global — see global.css. */

  /* ─── Notes + Photos Sections — compact gap after Projects ─── */
  .notes-section,
  .photos-section {
    margin-top: calc(var(--section-pad) * 0.5);
  }
</style>
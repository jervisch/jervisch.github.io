---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BuildingEntry from '../components/BuildingEntry.astro';
import NoteList from '../components/NoteList.astro';
import PhotoFeature from '../components/PhotoFeature.astro';
import { SITE } from '../config';
import { getCollection } from 'astro:content';

const notes = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const things = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const photos = (await getCollection('photos'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Pick a spread of photographs rather than the three newest from one trip.
const featurePhotos: typeof photos = [];
const seenCollections = new Set<string>();
for (const photo of photos) {
  if (featurePhotos.length >= 3) break;
  const key = photo.data.collection;
  if (seenCollections.has(key)) continue;
  seenCollections.add(key);
  featurePhotos.push(photo);
}
// If every photo shares one collection, fall back to simply taking the newest.
const chosenPhotos = featurePhotos.length >= 2
  ? featurePhotos
  : photos.slice(0, 3);
---

<BaseLayout currentPath="/" home>
  <!-- ─── Hero ─── -->
  <section class="hero">
    <h1 class="hero-name type-display">
      I make things,<br />
      think about systems,<br />
      and notice too much.
    </h1>
    <p class="hero-meta type-meta">
      {SITE.name} · {SITE.location} · Engineer
    </p>
  </section>

  <!-- ─── About ─── -->
  <section class="section about-teaser">
    <div class="editorial-grid">
      <div class="about-teaser-aside">
        <h2 class="type-label">About</h2>
      </div>
      <div class="about-teaser-body">
        <p class="about-statement">
          I like understanding how things work.<br />
          Then I like making them work better.
        </p>
        {SITE.now && <p class="about-now">Now: {SITE.now}</p>}
      </div>
    </div>
  </section>

  <!-- ─── Building ─── -->
  <section class="section">
    {things.length > 0 && (
      <>
        <SectionHeading title="Building" href="/building/" />
        <div class="things-list">
        {things.slice(0, 3).map((thing, i) => (
          <BuildingEntry
            number={i + 1}
            title={thing.data.title}
            description={thing.data.description}
            href={`/building/${thing.id}/`}
            cover={thing.data.cover}
            tags={thing.data.tags}
            {/* Only alternate when a cover exists — otherwise the flipped
                text lands in columns 8-12 with nothing filling 1-6. */}
            flip={i % 2 === 1 && Boolean(thing.data.cover)}
          />
        ))}
        </div>
      </>
    )}
  </section>

  <!-- ─── Notes ─── -->
  <section class="section">
    {notes.length > 0 && (
      <>
        <SectionHeading title="Notes" href="/notes/" />
        <NoteList
        notes={notes.slice(0, 5).map(note => ({
          title: note.data.title,
          href: `/notes/${note.id}/`,
          date: note.data.date,
        }))}
      />
      </>
    )}
  </section>

  <!-- ─── Photos ─── -->
  <section class="section">
    {chosenPhotos.length > 0 && (
      <>
        <SectionHeading title="Photos" href="/photos/" linkLabel="All photos" />
        <PhotoFeature
          photos={chosenPhotos.map(photo => ({
            title: photo.data.title,
            image: photo.data.image,
            location: photo.data.location,
            caption: photo.data.caption,
          }))}
        />
      </>
    )}
  </section>
</BaseLayout>

<style>
  /* ─── Hero ─── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(48px, 7vw, 88px);
  }

  .hero-name {
    margin: 0;
  }

  .hero-meta {
    margin-top: 40px;
  }

  /* ─── About teaser ─── */
  .about-teaser-aside {
    grid-column: 1 / span 3;
  }

  .about-teaser-body {
    grid-column: 5 / span 7;
  }

  .about-teaser-aside h2 {
    margin: 0;
  }

  .about-statement {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.5rem, 2.8vw, 2.125rem);
    line-height: 1.28;
    letter-spacing: -0.018em;
    color: var(--text);
  }

  .about-now {
    margin-top: 16px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .about-teaser-body .arrow-link {
    margin-top: 32px;
  }

  @media (max-width: 1024px) {
    .about-teaser-aside { grid-column: 1 / span 8; }
    .about-teaser-body { grid-column: 1 / span 8; margin-top: 28px; }
  }

  @media (max-width: 700px) {
    .about-teaser-aside,
    .about-teaser-body {
      grid-column: 1 / -1;
    }

    .about-statement br {
      display: none;
    }
  }
</style>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import NoteList from '../components/NoteList.astro';
import PhotoFeature from '../components/PhotoFeature.astro';
import { SITE } from '../config';
import { getCollection } from 'astro:content';

const notes = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const things = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const photos = (await getCollection('photos'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Pick a spread of photographs rather than the three newest from one trip.
const featurePhotos: typeof photos = [];
const seenCollections = new Set<string>();
for (const photo of photos) {
  if (featurePhotos.length >= 3) break;
  const key = photo.data.collection;
  if (seenCollections.has(key)) continue;
  seenCollections.add(key);
  featurePhotos.push(photo);
}
// If every photo shares one collection, fall back to simply taking the newest.
const chosenPhotos = featurePhotos.length >= 2
  ? featurePhotos
  : photos.slice(0, 3);
---

<BaseLayout currentPath="/">
  <!-- ─── Hero ─── -->
  <section class="hero">
    <h1 class="hero-name type-display">
      I make things,<br />
      think about systems,<br />
      and notice too much.
    </h1>
    <p class="hero-meta type-meta">
      {SITE.name} · {SITE.location} · Engineer
    </p>
  </section>

  <!-- ─── Things ─── -->
  <section class="section">
    <SectionHeading title="Things" href="/things/" />

    {things.length > 0 && (
      <div class="things-list">
        {things.slice(0, 3).map((thing, i) => (
          <ProjectFeature
            number={i + 1}
            title={thing.data.title}
            description={thing.data.description}
            href={`/things/${thing.id}/`}
            status={thing.data.status}
            year={thing.data.year}
            tags={thing.data.tags}
            flip={i % 2 === 1}
          />
        ))}
      </div>
    )}
  </section>

  <!-- ─── Notes ─── -->
  <section class="section">
    <SectionHeading title="Notes" href="/notes/" />

    {notes.length > 0 && (
      <NoteList
        notes={notes.slice(0, 5).map(note => ({
          title: note.data.title,
          href: `/notes/${note.id}/`,
          date: note.data.date,
        }))}
      />
    )}
  </section>

  <!-- ─── Places ─── -->
  <section class="section">
    <SectionHeading title="Places" href="/places/" linkLabel="All places" />
    <PhotoFeature
      photos={chosenPhotos.map(photo => ({
        title: photo.data.title,
        image: photo.data.image,
        location: photo.data.location,
        caption: photo.data.caption,
      }))}
    />
  </section>

  <!-- ─── About ─── -->
  <section class="section about-teaser">
    <div class="editorial-grid">
      <div class="about-teaser-aside">
        <h2 class="type-label">About</h2>
      </div>
      <div class="about-teaser-body">
        <p class="about-statement">
          I like understanding how things work.<br />
          Then I like making them work better.
        </p>
        <p class="about-detail">
          Software, systems, and the space where the two meet.
        </p>
        <a href="/about/" class="arrow-link">
          More about me
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero ─── */
  .hero {
    padding-block: clamp(72px, 12vw, 168px) clamp(64px, 9vw, 120px);
  }

  .hero-name {
    margin: 0;
    max-width: 20ch;
  }

  .hero-meta {
    margin-top: 40px;
  }

  /* ─── About teaser ─── */
  .about-teaser-aside {
    grid-column: 1 / span 3;
  }

  .about-teaser-body {
    grid-column: 5 / span 7;
  }

  .about-teaser-aside h2 {
    margin: 0;
  }

  .about-statement {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(1.5rem, 2.8vw, 2.125rem);
    line-height: 1.28;
    letter-spacing: -0.018em;
    color: var(--text);
  }

  .about-detail {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-top: 20px;
  }

  .about-teaser-body .arrow-link {
    margin-top: 32px;
  }

  @media (max-width: 1024px) {
    .about-teaser-aside { grid-column: 1 / span 8; }
    .about-teaser-body { grid-column: 1 / span 8; margin-top: 28px; }
  }

  @media (max-width: 700px) {
    .about-teaser-aside,
    .about-teaser-body {
      grid-column: 1 / -1;
    }

    .about-statement br {
      display: none;
    }
  }
</style>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BuildingEntry from '../components/BuildingEntry.astro';
import NoteList from '../components/NoteList.astro';
import PhotoFeature from '../components/PhotoFeature.astro';
import { SITE } from '../config';
import { getCollection } from 'astro:content';

const notes = (await getCollection('posts'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const things = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const photos = (await getCollection('photos'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Pick a spread of photographs rather than the three newest from one trip.
const featurePhotos: typeof photos = [];
const seenCollections = new Set<string>();
for (const photo of photos) {
  if (featurePhotos.length >= 3) break;
  const key = photo.data.collection;
  if (seenCollections.has(key)) continue;
  seenCollections.add(key);
  featurePhotos.push(photo);
}
// If every photo shares one collection, fall back to simply taking the newest.
const chosenPhotos = featurePhotos.length >= 2
  ? featurePhotos
  : photos.slice(0, 3);
---

<BaseLayout currentPath="/" home>
  <!-- ─── Hero ─── -->
  <section class="hero">
    <h1 class="hero-name type-display">
      I make things,<br />
      think about systems,<br />
      and notice too much.
    </h1>
    <p class="hero-meta type-meta">
      {SITE.name} · {SITE.location} · Engineer
    </p>
  </section>

  <!-- ─── Building ─── -->
  <section class="section building-section">
    <SectionHeading title="Building" href="/building/" />
    {things.length > 0 && (
      <div class="things-list">
        {things.slice(0, 3).map((thing, i) => (
          <BuildingEntry
            number={i + 1}
            title={thing.data.title}
            description={thing.data.description}
            href={`/building/${thing.id}/`}
            cover={thing.data.cover}
            tags={thing.data.tags}
            flip={i % 2 === 1}
          />
        ))}
      </div>
    )}
  </section>

  <!-- ─── Notes ─── -->
  <section class="section notes-section">
    <SectionHeading title="Notes" href="/notes/" />
    {notes.length > 0 && (
      <NoteList
        notes={notes.slice(0, 5).map(note => ({
          title: note.data.title,
          href: `/notes/${note.id}/`,
          date: note.data.date,
        }))}
      />
    )}
  </section>

  <!-- ─── Photos ─── -->
  <section class="section photos-section">
    <SectionHeading title="Photos" href="/photos/" linkLabel="All photos" />
    <PhotoFeature
      photos={chosenPhotos.map(photo => ({
        title: photo.data.title,
        image: photo.data.image,
        location: photo.data.location,
        caption: photo.data.caption,
      }))}
    />
  </section>
</BaseLayout>

<style>
  /* ─── Hero ─── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(48px, 7vw, 88px);
  }

  .hero-name {
    margin: 0;
  }

  .hero-meta {
    margin-top: 40px;
  }

  /* ─── Sections ─── */
  .section {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-top: var(--section-pad);
  }

  .section .section-heading {
    margin-bottom: var(--heading-gap);
  }

  /* Building section - alternating layout */
  .building-section .things-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    flex: 1;
  }

  .building-section .feature {
    min-height: 100svh;
  }

  /* Notes section */
  .notes-section .note-list {
    flex: 1;
  }

  /* Photos section */
  .photos-section .photo-feature {
    flex: 1;
  }

  @media (max-width: 700px) {
    .section {
      min-height: auto;
      padding-top: var(--section-pad);
      padding-bottom: var(--section-pad);
    }
  }
</style>
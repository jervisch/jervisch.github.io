---
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ShareButton from '../components/ShareButton.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  minutesRead: number;
  description?: string;
}

const { title, date, tags = [], minutesRead, description } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);

const pageUrl = `${SITE.url}${Astro.url.pathname}`;
---

<BaseLayout title={title} description={description} prose>
  <ReadingProgress />

  <a href="/notes/" class="back-link">← Back to notes</a>

  <article class="post">
    <header class="post-header">
      <div class="post-meta type-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span class="dot" aria-hidden="true"></span>
        <span>{minutesRead} min read</span>
      </div>

      <h1 class="type-title post-title">{title}</h1>

      {description && <p class="post-deck">{description}</p>}

      {tags.length > 0 && (
        <ul class="post-tags">
          {tags.map(tag => <li class="type-meta">{tag}</li>)}
        </ul>
      )}
    </header>

    <div class="prose post-body">
      <slot />
    </div>

    <footer class="post-footer">
      <a href="/notes/" class="back-link">← All notes</a>
      <ShareButton title={title} url={pageUrl} />
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    padding-bottom: var(--heading-gap);
    margin-bottom: clamp(40px, 5vw, 56px);
    border-bottom: 1px solid var(--border);
    transition: border-color 0.4s;
  }

  .post-meta {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 20px;
  }

  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .post-title {
    margin: 0;
    max-width: 22ch;
  }

  .post-deck {
    margin-top: 20px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 46ch;
  }

  .post-tags {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .post-footer {
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .post-footer .back-link {
    margin-bottom: 0;
  }
</style>
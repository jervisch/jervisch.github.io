---
import { getPhotoGradient, photoExists } from '../lib/photoGradient';
import { getCollection } from 'astro:content';

// Group collections with their hero images
const photosData = await getCollection('photos');
const collections = new Map<string, typeof photosData>();
for (const photo of photosData) {
  const key = photo.data.collection;
  if (!collections.has(key)) collections.set(key, []);
  collections.get(key)!.push(photo);
}

const collectionEntries = Array.from(collections.entries())
  .map(([name, collectionPhotos]) => {
    // Sort photos within collection by date desc (newest first)
    collectionPhotos.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    // The photo that represents the collection: an explicit `cover: true`
    // if one is set, otherwise the newest by date.
    const hero = collectionPhotos.find(p => p.data.cover) ?? collectionPhotos[0];
    return {
      name,
      count: collectionPhotos.length,
      heroImage: hero.data.image,
      heroExists: photoExists(hero.data.image),
      latestDate: hero.data.date.valueOf(),
    };
  })
  .sort((a, b) => b.latestDate - a.latestDate) // sort collections by latest photo
  .slice(0, 6); // show up to 6 collections
---

<!-- Horizontal scroll carousel for photo collections - gallery style.
     Renders photos only — the section heading and "All Photos" link live in
     src/pages/index.astro alongside the Projects and Notes headers. -->
<div class="photos-carousel">
  <!-- Bleeds to the viewport edge so the scroll reads as continuing past the
       section's own right margin. Requires a full-bleed wrapper — the page
       container already supplies --page-pad, so the track must not re-add it. -->
  <div class="carousel-viewport">
    <div class="carousel-track">
      {collectionEntries.map((collection) => (
        <article class="carousel-card">
          <a href={`/photos/${collection.name.toLowerCase().replace(/\s+/g, '-')}/`} class="carousel-link" aria-label={`${collection.name} — view all photos`}>
            <div class="carousel-image" style={`background: ${getPhotoGradient(collection.heroImage)};`}>
              {collection.heroExists && (
                <img src={collection.heroImage} alt="" loading="lazy" onload="this.style.opacity=1" />
              )}
            </div>
            <!-- Caption sits over the photograph, revealed on hover. On touch
                 devices there is no hover, so it stays visible there. -->
            <div class="carousel-caption">
              <h3 class="carousel-title">{collection.name}</h3>
              <p class="carousel-meta">
                <span class="carousel-count">{collection.count} {collection.count === 1 ? 'photo' : 'photos'}</span>
                <span class="carousel-date">{new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(new Date(collection.latestDate))}</span>
              </p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  /* Breaks out of the page container so the track can scroll past the
     right edge of the viewport. This is the full-bleed wrapper. */
  .carousel-viewport {
    margin-right: calc(-1 * var(--page-pad));
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    gap: var(--grid-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* Hide scrollbar but keep scrollable */
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
  
  .carousel-card {
    flex: 0 0 clamp(380px, 45vw, 520px);
    scroll-snap-align: start;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s;
  }

  .carousel-card:hover {
    transform: translateY(-4px);
  }
  
  .carousel-link {
    display: block;
    position: relative;
    text-decoration: none;
    color: inherit;
  }
  
  .carousel-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }
  
  .carousel-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: transform 0.4s, opacity 0.3s;
  }
  
  .carousel-image img[style*="opacity: 1"] {
    opacity: 1;
  }
  
  .carousel-link:hover .carousel-image img {
    transform: scale(1.03);
  }
  
  /* ─── CAPTION ───
     Overlays the photograph rather than sitting below it, so there is no
     empty surface strip reserving space before hover. A scrim carries the
     contrast instead of a solid panel. */
  .carousel-caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 32px 16px 16px;
    background: linear-gradient(transparent, rgba(26, 23, 20, 0.72));
    color: #FAF7F2;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s, transform 0.3s;
    pointer-events: none;
  }
  
  .carousel-link:hover .carousel-caption,
  .carousel-link:focus-visible .carousel-caption {
    opacity: 1;
    transform: translateY(0);
  }
  
  /* No hover on touch — keep the caption legible rather than hidden */
  @media (hover: none) {
    .carousel-caption {
      opacity: 1;
      transform: none;
    }
  }
  
  .carousel-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 1.3;
    color: inherit;
    margin: 0 0 4px;
  }
  
  .carousel-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(250, 247, 242, 0.75);
    margin: 0;
  }
  
/* ─── REDUCE MOTION ─── */
  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      scroll-behavior: auto;
    }
    
    .carousel-image img {
      transition: opacity 0.3s;
    }

    .carousel-link:hover .carousel-image img {
      transform: none;
    }

    .carousel-caption {
      transition: opacity 0.3s;
    }

    .carousel-card:hover {
      transform: none;
    }
  }
</style>
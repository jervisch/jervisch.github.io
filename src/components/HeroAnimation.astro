---
<div class="topography" id="hero-animation" role="img" aria-label="Animated topography with flowing contours and ink-like forms in editorial colors">
  <canvas></canvas>
  <p class="fallback" hidden>This piece needs WebGL, which this browser couldn't start.</p>
</div>

<script>
  const container = document.getElementById('hero-animation');
  const fallback = container?.querySelector('.fallback');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Probe on a throwaway canvas — calling getContext on the real one would
  // lock in a context that Three cannot reuse. This also avoids pulling in
  // Three on browsers that could never run it.
  const probe = document.createElement('canvas');
  const hasWebGL = !!(probe.getContext('webgl2') || probe.getContext('webgl'));

  if (reducedMotion) {
    // Deliberately leave the canvas blank — the statement carries the hero.
  } else if (!hasWebGL) {
    if (fallback) fallback.hidden = false;
  } else {
    import('/src/components/hero-shader.js')
      .then(module => module.initHeroShader('hero-animation'))
      .catch(err => console.warn('Hero shader failed to load:', err));
  }
</script>

<style>
  .topography {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  
  .topography canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  
  .topography .fallback {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.5;
    text-align: center;
    max-width: 80%;
  }
</style>
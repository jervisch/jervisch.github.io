---
import { getEntry, type CollectionKey } from 'astro:content';

interface Props {
  refs: string[];
}

const { refs } = Astro.props;

// Collections that have a per-entry detail page, so a ref to one can be
// rendered as a link. `photos` is deliberately excluded: /photos/<slug> is one
// page per collection (Singapore, Japan, …), not per photo, so a photo ref has
// no leaf page to point at. The `satisfies` clause makes renaming or removing a
// collection a build error here rather than a silent dead link.
const REF_COLLECTIONS = ['notes', 'projects'] as const satisfies readonly CollectionKey[];

type RefCollection = (typeof REF_COLLECTIONS)[number];

function isRefCollection(value: string): value is RefCollection {
  return (REF_COLLECTIONS as readonly string[]).includes(value);
}

interface TimelineItem {
  title: string;
  url: string;
  date: Date | undefined;
}

const resolvedWork = await Promise.all(
  refs.map(async (ref: string): Promise<TimelineItem | null> => {
    const [collection, id] = ref.split('/');
    if (!isRefCollection(collection) || !id) {
      throw new Error(
        `Timeline: "${ref}" is not a valid reference. Expected "<collection>/<id>" ` +
          `where collection is one of: ${REF_COLLECTIONS.join(', ')}.`
      );
    }

    const entry = await getEntry(collection, id);
    if (!entry) {
      throw new Error(`Timeline: "${ref}" does not match any entry in "${collection}".`);
    }

    // Draft notes get no production page — skip them outside dev to avoid dead links
    if ('draft' in entry.data && entry.data.draft && !import.meta.env.DEV) return null;

    return {
      title: entry.data.title,
      url: `/${collection}/${id}/`,
      date: 'date' in entry.data ? (entry.data.date as Date) : undefined,
    };
  })
);

const timeline = resolvedWork
  .filter((w): w is TimelineItem => w !== null)
  .sort((a, b) => {
    if (a.date && b.date) return b.date.valueOf() - a.date.valueOf();
    if (a.date) return -1;
    return 1;
  });
---

{timeline.length > 0 && (
  <div class="related-work">
    <div class="section-label">Timeline</div>
    <div class="timeline">
      {timeline.map((work, i) => (
        <a href={work.url} class="timeline-item">
          <span class="timeline-date">
            {work.date ? new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(work.date) : ''}
          </span>
          <span class="timeline-dot-wrapper">
            <span class="timeline-dot"></span>
            {i < timeline.length - 1 && <span class="timeline-line"></span>}
          </span>
          <span class="timeline-title">{work.title}</span>
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .related-work {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .related-work .section-label {
    margin-bottom: 20px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 72px 20px 1fr;
    gap: 0 12px;
    align-items: start;
    text-decoration: none;
    color: inherit;
    padding: 2px 0;
    transition: transform 0.2s;
  }

  .timeline-item:hover {
    transform: translateX(4px);
  }

  .timeline-date {
    font-size: 11px;
    font-weight: 300;
    color: var(--text-muted);
    text-align: right;
    padding-top: 2px;
    transition: color 0.3s;
  }

  .timeline-dot-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 5px;
  }

  .timeline-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .timeline-line {
    width: 1px;
    height: 32px;
    background: var(--border);
    margin-top: 4px;
    transition: background 0.3s;
  }

  .timeline-title {
    font-size: 14px;
    font-weight: 400;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
    transition: text-decoration-color 0.3s, color 0.3s;
    padding-bottom: 20px;
  }

  .timeline-item:hover .timeline-title {
    text-decoration-color: var(--accent);
  }

  .timeline-item:last-child .timeline-title {
    padding-bottom: 0;
  }
</style>

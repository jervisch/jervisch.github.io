---
import { getPhotoGradient, photoExists } from '../lib/photoGradient';

interface Photo {
  title: string;
  image: string;
  location?: string;
  date: Date;
  size: 'square' | 'tall' | 'wide';
  tags: string[];
  caption?: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

const resolved = photos.map(p => ({ ...p, hasImage: photoExists(p.image) }));
---

<div class="gallery-grid">
  {resolved.map((photo, i) => (
    <div
      class={`gallery-item ${photo.size !== 'square' ? photo.size : ''}`}
      role="button"
      tabindex="0"
      aria-label={`View ${photo.title}${photo.location ? `, ${photo.location}` : ''}`}
      data-index={i}
      data-title={photo.title}
      data-location={photo.location || ''}
      data-date={new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' }).format(photo.date)}
      data-tags={photo.tags.join(', ')}
      data-image={photo.image}
    >
      <div
        class="gallery-img"
        style={`background: ${getPhotoGradient(photo.image)};`}
        role="img"
        aria-label={photo.title}
      >
        {/* Only emit an <img> when the file exists. The gradient stands in otherwise. */}
        {photo.hasImage && (
          <img src={photo.image} alt={photo.title} loading="lazy" />
        )}
      </div>
      <div class="gallery-overlay">
        <div class="gallery-overlay-text">
          <div class="gallery-overlay-title">{photo.title}</div>
          {photo.location && <div class="gallery-overlay-location">{photo.location}</div>}
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.3s;
  }

  .gallery-item:hover {
    transform: scale(1.02);
  }

  .gallery-item:hover .gallery-overlay {
    opacity: 1;
  }

  .gallery-img {
    width: 100%;
    aspect-ratio: 1;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .gallery-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-item.tall {
    grid-row: span 2;
  }

  .gallery-item.tall .gallery-img {
    aspect-ratio: auto;
    height: 100%;
  }

  .gallery-item.wide {
    grid-column: span 2;
  }

  .gallery-item.wide .gallery-img {
    aspect-ratio: 2 / 1;
  }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 50%, rgba(26, 23, 20, 0.7));
    opacity: 0;
    transition: opacity 0.3s;
    display: flex;
    align-items: flex-end;
    padding: 16px;
  }

  .gallery-overlay-text {
    color: #FAF7F2;
  }

  .gallery-overlay-title {
    font-size: 13px;
    font-weight: 400;
  }

  .gallery-overlay-location {
    font-size: 10px;
    color: rgba(250, 247, 242, 0.6);
    margin-top: 2px;
    font-weight: 300;
  }

  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gallery-item.tall { grid-row: span 1; }
    .gallery-item.tall .gallery-img { aspect-ratio: 1; }
    .gallery-item.wide { grid-column: span 1; }
    .gallery-item.wide .gallery-img { aspect-ratio: 1; }
  }

  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

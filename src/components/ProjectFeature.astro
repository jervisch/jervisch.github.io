---
interface Props {
  number: number;
  title: string;
  description: string;
  href: string;
  status?: string;
  year?: number;
  tags?: string[];
  flip?: boolean;
}

const {
  number,
  title,
  description,
  href,
  status,
  year,
  tags = [],
  flip = false,
} = Astro.props;

const numeral = String(number).padStart(2, '0');
---

<article class:list={['feature', { flip }]}>
  <div class="feature-text">
    <span class="feature-number" aria-hidden="true">{numeral}</span>

    <div class="feature-body">
      <h3 class="feature-title">
        <a href={href} class="feature-title-link">
          {title}
          <span class="visually-hidden"> — view project</span>
        </a>
      </h3>

      {(status || year) && (
        <p class="feature-meta type-meta">
          {[status, year].filter(Boolean).join(' · ')}
        </p>
      )}

      <p class="feature-description">{description}</p>

      {tags.length > 0 && (
        <ul class="feature-tags">
          {tags.map(tag => <li class="type-meta">{tag}</li>)}
        </ul>
      )}

      <a href={href} class="arrow-link feature-link">
        Read more
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <!--
    No project imagery exists yet. This block reserves the composition's
    visual weight and marks itself honestly as unfilled rather than
    rendering a broken image.
  -->
  <div class="feature-visual" aria-hidden="true">
    <span class="feature-visual-label">Awaiting cover image</span>
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    align-items: start;
    padding-block: clamp(48px, 6vw, 80px);
    border-top: 1px solid var(--border);
    transition: border-color 0.4s;
  }

  .feature:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .feature-text {
    grid-column: 1 / span 5;
  }

  .feature-visual {
    grid-column: 7 / span 6;
    aspect-ratio: 4 / 3;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    display: flex;
    align-items: flex-end;
    padding: 16px;
    transition: background 0.4s, border-color 0.4s;
  }

  /* Alternate the composition so the page never reads as a stack of cards */
  .feature.flip .feature-text {
    grid-column: 8 / span 5;
    order: 2;
  }

  .feature.flip .feature-visual {
    grid-column: 1 / span 6;
    order: 1;
  }

  .feature-visual-label {
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.7;
  }

  .feature-number {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .feature-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.625rem, 2.6vw, 2.25rem);
    line-height: 1.12;
    letter-spacing: -0.022em;
    margin: 0 0 12px;
  }

  .feature-title-link {
    transition: color 0.2s;
  }

  .feature-title-link:hover {
    color: var(--accent);
  }

  .feature-meta {
    margin: 0 0 20px;
  }

  .feature-description {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 38ch;
  }

  .feature-tags {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .feature-link {
    margin-top: 28px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1024px) {
    .feature-text,
    .feature.flip .feature-text { grid-column: 1 / span 8; order: 1; }
    .feature-visual,
    .feature.flip .feature-visual { grid-column: 1 / span 8; order: 2; margin-top: 36px; }
  }

  @media (max-width: 700px) {
    .feature-text,
    .feature.flip .feature-text,
    .feature-visual,
    .feature.flip .feature-visual {
      grid-column: 1 / -1;
    }
  }
</style>
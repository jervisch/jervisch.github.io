---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../config';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const links = [
  { href: '/building/', label: 'Building' },
  { href: '/notes/', label: 'Notes' },
  { href: '/photos/', label: 'Photos' },
  { href: '/about/', label: 'About' },
];

function isActive(linkHref: string, current: string): boolean {
  if (linkHref === '/') return current === '/';
  return current.startsWith(linkHref.replace(/\/$/, ''));
}
---

<nav class="nav">
  <a href="/" class="nav-wordmark">Jervis</a>

  <div class="nav-right">
    <ul class="nav-links">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive(link.href, currentPath) }]}
            aria-current={isActive(link.href, currentPath) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <ThemeToggle />
    <button
      class="hamburger"
      id="hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span>
    </button>
  </div>
</nav>

<!-- Mobile menu overlay -->
<div class="mobile-menu" id="mobile-menu" hidden>
  <div class="mobile-menu-backdrop" id="mobile-menu-backdrop"></div>
  <div class="mobile-menu-panel" role="dialog" aria-modal="true" aria-label="Menu">
    <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Close menu">&times;</button>
    <ul class="mobile-menu-links">
      {links.map((link, i) => (
        <li class="mobile-menu-item" style={`--i: ${i}`}>
          <a
            href={link.href}
            class:list={['mobile-link', { active: isActive(link.href, currentPath) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mobile-menu-foot">
      <span class="mobile-menu-place">{SITE.location}</span>
      <ThemeToggle />
    </div>
  </div>
</div>

<style>
  .nav {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 40px var(--page-pad) 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
  }

  

  .nav-wordmark {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text);
    transition: opacity 0.2s;
  }

  .nav-wordmark:hover {
    opacity: 0.6;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-links {
    display: flex;
    gap: 26px;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color 0.2s;
    position: relative;
    padding-bottom: 2px;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover { color: var(--text); }
  .nav-link:hover::after { width: 100%; }
  .nav-link.active { color: var(--text); }
  .nav-link.active::after { width: 100%; }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 24px;
    height: 24px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--text);
    transition: background 0.2s;
  }

  .hamburger:hover span { background: var(--accent); }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 18, 12, 0.35);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .mobile-menu.open .mobile-menu-backdrop {
    opacity: 1;
  }

  .mobile-menu-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(340px, 88vw);
    background: var(--bg);
    padding: 40px 40px 40px;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    border-left: 1px solid var(--border);
  }

  .mobile-menu.open .mobile-menu-panel {
    transform: translateX(0);
  }

  .mobile-menu-close {
    position: absolute;
    top: 24px;
    right: 28px;
    background: none;
    border: none;
    font-size: 26px;
    line-height: 1;
    color: var(--text-muted);
    cursor: pointer;
    font-family: var(--font-sans);
    transition: color 0.2s;
  }

  .mobile-menu-close:hover { color: var(--text); }

  .mobile-menu-links {
    display: flex;
    flex-direction: column;
    margin-top: 96px;
  }

  .mobile-menu-item {
    border-top: 1px solid var(--border);
    opacity: 0;
    transform: translateY(10px);
  }

  .mobile-menu.open .mobile-menu-item {
    animation: fadeUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.08s + var(--i) * 0.05s);
  }

  .mobile-menu-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .mobile-link {
    display: block;
    padding: 22px 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 1.75rem;
    letter-spacing: -0.02em;
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .mobile-link.active { color: var(--text); }
  .mobile-link:hover { color: var(--accent); }

  .mobile-menu-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-menu-place {
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 700px) {
    .nav { padding-top: 28px; }
    .nav-links { display: none; }
    .nav-right > :global(.theme-toggle) { display: none; }
    .hamburger { display: flex; }
  }
</style>

<script is:inline>
  function initMenu() {
    const hamburger = document.getElementById('hamburger');
    const menu = document.getElementById('mobile-menu');
    const closeBtn = document.getElementById('mobile-menu-close');
    const backdrop = document.getElementById('mobile-menu-backdrop');

    if (!menu || !hamburger) return;

    // Avoid double-binding after ClientRouter swaps
    if (menu.dataset.bound === 'true') return;
    menu.dataset.bound = 'true';

    function openMenu() {
      menu.hidden = false;
      // Next frame, so the transition runs from translateX(100%)
      requestAnimationFrame(() => menu.classList.add('open'));
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeMenu() {
      menu.classList.remove('open');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      const done = () => { menu.hidden = true; };
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) done();
      else setTimeout(done, 350);
    }

    hamburger.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        closeMenu();
        hamburger.focus();
      }
    });

    // Following a link should not leave the menu locked
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  }

  initMenu();
  document.addEventListener('astro:after-swap', initMenu);
</script>